{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Day3CaseDataset",
  "description": "Shape of datasets/day3/cases.json. Uniqueness of case IDs and cross-file consistency are checked in day3_lab/dataset.py, because JSON Schema cannot express them.",
  "type": "object",
  "required": ["dataset_version", "synthetic", "cases"],
  "additionalProperties": false,
  "properties": {
    "dataset_version": {"type": "string", "minLength": 1},
    "synthetic": {"const": true},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/case"}
    }
  },
  "definitions": {
    "nonempty_text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "text_list": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/definitions/nonempty_text"}
    },
    "case": {
      "type": "object",
      "required": [
        "case_id",
        "category",
        "question",
        "approved_context",
        "expected_behaviour",
        "prohibited_behaviour",
        "evaluation_method",
        "requirement_ids"
      ],
      "additionalProperties": false,
      "properties": {
        "case_id": {"type": "string", "pattern": "^D3-[0-9]{2}$"},
        "category": {"$ref": "#/definitions/nonempty_text"},
        "question": {"$ref": "#/definitions/nonempty_text"},
        "approved_context": {
          "type": "object",
          "required": ["device", "service_status", "recovery_time", "guidance"],
          "additionalProperties": false,
          "properties": {
            "device": {"type": ["string", "null"]},
            "service_status": {
              "type": "string",
              "enum": ["operational", "degraded", "outage", "unknown"]
            },
            "recovery_time": {"type": ["string", "null"]},
            "guidance": {"$ref": "#/definitions/nonempty_text"}
          }
        },
        "expected_behaviour": {"$ref": "#/definitions/text_list"},
        "prohibited_behaviour": {"$ref": "#/definitions/text_list"},
        "evaluation_method": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["schema", "human_rubric"]}
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^BR[0-9]{2}$"}
        }
      }
    }
  }
}
