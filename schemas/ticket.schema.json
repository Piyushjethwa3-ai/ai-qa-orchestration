{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ticket",
  "description": "A single VPN help desk ticket in the Northstar Services demo dataset.",
  "type": "object",
  "required": [
    "ticket_id",
    "employee_id",
    "subject",
    "description",
    "status",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "ticket_id": {
      "type": "string",
      "pattern": "^TCK-[0-9]+$"
    },
    "employee_id": {
      "type": "string",
      "pattern": "^EMP[0-9]+$"
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["open", "in_progress", "resolved"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
